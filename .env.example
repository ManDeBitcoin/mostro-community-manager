# Defaults work without any financial infrastructure. Never commit real credentials.
API_BIND=127.0.0.1:3001
CONFIG_DIR=./var/config
# Optional read-only probes, supplied only to the API process:
# MOSTRO_RPC_URL=http://127.0.0.1:50051
# LND_REST_URL=https://your-lnd-host:8080
# LND_TLS_CERT=/path/to/tls.cert
# LND_READONLY_MACAROON=/path/to/readonly.macaroon
# LND for the daemon, as the mostro container sees it. Without
# MOSTRO_LND_GRPC_HOST the panel uses Umbrel's APP_LIGHTNING_NODE_IP and
# APP_LIGHTNING_NODE_GRPC_PORT, and with neither it refuses to activate.
# MOSTRO_LND_GRPC_HOST=https://lnd:10009
# MOSTRO_LND_CERT_FILE=/lnd/tls.cert
# MOSTRO_LND_MACAROON_FILE=/lnd/mostro.macaroon
# Reverse proxies in front of the panel whose X-Forwarded-For is believed
# (addresses or CIDR ranges); without it the connecting address is used.
# TRUSTED_PROXIES=172.16.0.0/12
