# Copia este archivo como .env y completa lo que falta. Guía: docs/instalar-docker.md

# Versión del Manager. ../actualizar.sh la cambia y la fija por digest.
MCM_IMAGE=ghcr.io/mandebitcoin/mostro-community-manager:1.0.16

# Nombre del proyecto de Docker Compose (prefijo de los contenedores).
COMPOSE_PROJECT_NAME=mostro-manager

# Dónde escucha el panel. Por defecto solo en este equipo: entra por un túnel
# SSH (ssh -L 5173:127.0.0.1:5173 servidor) o pon delante un proxy con HTTPS.
# Pide la contraseña de secrets/panel_password aunque escuche en otra dirección.
PANEL_BIND=127.0.0.1
PANEL_PORT=5173
# Si pones un proxy inverso delante, su dirección (o un rango CIDR), para que
# el límite de peticiones cuente a cada cliente y no al proxy.
# TRUSTED_PROXIES=172.16.0.0/12

# Tu LND, tal como lo ven los contenedores. Su certificado (lnd/ro/tls.cert)
# tiene que incluir ese nombre o IP: en lnd.conf, tlsextradomain= o tlsextraip=
# (y borrar tls.cert y tls.key para que LND los regenere).
#   - LND en otro contenedor: su nombre de servicio en una red compartida
#     (ver docker-compose.red-lnd.yml), por ejemplo https://lnd:10009
#   - LND en este mismo equipo, fuera de Docker: https://host.docker.internal:10009
#     (LND tiene que escuchar en una dirección alcanzable desde Docker, no solo 127.0.0.1)
LND_GRPC_HOST=https://lnd:10009
LND_REST_URL=https://lnd:8080
# Solo si el certificado no incluye el nombre de LND_REST_URL: el panel se
# conecta a este host:puerto pero valida el certificado con el de LND_REST_URL
# (por ejemplo LND_REST_URL=https://localhost:8080 y LND_CONNECT_HOST=host.docker.internal:8080).
# LND_CONNECT_HOST=

# Respaldo automático cifrado cada 24 h en data/backup (mínimo 16 caracteres).
# Sin ella, los respaldos se hacen a mano desde el panel.
# BACKUP_PASSPHRASE=

# Para unir los contenedores a la red de Docker de tu LND (ver docker-compose.red-lnd.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.red-lnd.yml
# LND_DOCKER_NETWORK=nombre-de-la-red-de-lnd
