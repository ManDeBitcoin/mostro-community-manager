# Copia este archivo como .env (./preparar.sh lo hace por ti). Guía: docs/instalar-nodo-completo.md

# Versión del Manager. ../actualizar.sh la cambia y la fija por digest.
MCM_IMAGE=ghcr.io/mandebitcoin/mostro-community-manager:1.0.16

# Nombre del proyecto de Docker Compose (prefijo de los contenedores).
COMPOSE_PROJECT_NAME=mostro-nodo

# Dónde escucha el panel. Por defecto solo en este equipo: entra por un túnel
# SSH (ssh -L 5173:127.0.0.1:5173 servidor), por una VPN como Tailscale (pon
# aquí su IP) o con un proxy con HTTPS delante. Pide la contraseña de
# secrets/panel/panel_password aunque escuche en otra dirección.
PANEL_BIND=127.0.0.1
PANEL_PORT=5173
# Si pones un proxy inverso delante, su dirección (o un rango CIDR).
# TRUSTED_PROXIES=172.16.0.0/12

# Puerto P2P de Lightning publicado en el equipo, para recibir conexiones de
# otros nodos. Para anunciarlo, añade externalip=<tu IP pública> a data/lnd/lnd.conf.
LND_P2P_BIND=0.0.0.0
LND_P2P_PORT=9735

# Memoria máxima de bitcoind y LND. Con dbcache=300 (bitcoin.conf) bitcoind cabe en 1200m.
# BITCOIND_MEM_LIMIT=1200m
# LND_MEM_LIMIT=1536m

# Respaldo automático cifrado cada 24 h en data/mostro/backup (mínimo 16 caracteres).
# Sin ella, los respaldos se hacen a mano desde el panel.
# BACKUP_PASSPHRASE=
