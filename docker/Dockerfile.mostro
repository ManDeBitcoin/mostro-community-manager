# Opt-in integration image. Uses verified official release artifacts, no protocol fork.
FROM debian:bookworm-slim AS download
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ncurses-base && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) artifact=mostrod-x86_64-unknown-linux-musl; checksum=2d11a6940dd2d76742a903dbe7cfe82325421fdef016721fecf28f54e1d4773d ;; \
      arm64) artifact=mostrod-aarch64-unknown-linux-musl; checksum=bbc62158db39aec5b14f3ea83965394a505e2e09a3bda91714076f9ad585b048 ;; \
      *) echo 'Unsupported architecture' >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/MostroP2P/mostro/releases/download/v0.20.2/$artifact" -o /mostrod; \
    echo "$checksum  /mostrod" | sha256sum -c -; \
    chmod 755 /mostrod; \
    TERM=xterm /mostrod --version
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ncurses-base procps && rm -rf /var/lib/apt/lists/*
COPY --from=download /mostrod /usr/local/bin/mostrod
# mostrod is GPL-3.0-or-later since v0.19.2: ship its license and source pointer.
COPY config/upstream/LICENSE-GPL-3.0-or-later /usr/share/licenses/mostrod/LICENSE
COPY config/upstream/LICENSE-MIT /usr/share/licenses/mostrod/LICENSE-MIT
COPY config/upstream/NOTICE-mostrod.md /usr/share/licenses/mostrod/NOTICE.md
COPY docker/mostro-entrypoint.sh /usr/local/bin/mostro-entrypoint
USER 1000:1000
WORKDIR /data
ENV TERM=xterm
# The mostrod release above; the entrypoint copies the database before another one starts.
ENV MOSTROD_VERSION=0.20.2
# Deliberately no default settings or identity: both must be mounted explicitly.
ENTRYPOINT ["/bin/sh", "/usr/local/bin/mostro-entrypoint"]
